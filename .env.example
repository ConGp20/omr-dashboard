# OMR Dashboard configuration. Copy to .env and adjust.

# Demo mode: serve synthetic data without a live VPS/router (great for trying it out).
OMR_DASHBOARD_DEMO=false

# Server key of this VPS (from /root/openmptcprouter_config.txt). Used to talk
# to the existing omr-admin API on port 65500.
OMR_ADMIN_KEY=

# Router (LuCI) credentials — used to detect WANs and push config during setup.
ROUTER_IP=192.168.100.1
ROUTER_USER=root
ROUTER_PASS=

# Bind address for the dashboard. Set to your WireGuard management tunnel IP
# (e.g. 10.255.247.1) so the dashboard is ONLY reachable through the router,
# never on the public interface. Leave as 127.0.0.1 for local-only access.
BIND_ADDR=127.0.0.1

# Dashboard login password (defaults to OMR_ADMIN_KEY when empty).
DASHBOARD_PASS=

# Secret used to sign dashboard session tokens. Change this!
JWT_SECRET=change-me-to-a-long-random-string
